{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Mein Plex",
          "summary": "Play music from your own Plex media server",
          "description": "Mein Plex is an Alexa music skill which allows you to play music hosted by your own Plex media server on any Alexa device, including multi-room music groups.",
          "examplePhrases": [
            "Alexa, play some music on Mein Plex",
            "Alexa, play rock music on Mein Plex"
          ],
          "keywords": ["music", "plex", "media server"]
        },
        "de-DE": {
          "name": "Mein Plex",
          "summary": "Spiele Musik von deinem eigenen Plex Media Server",
          "description": "Mein Plex ist ein Alexa-Musik-Skill, mit dem du Musik von deinem eigenen Plex Media Server auf beliebigen Alexa-Geräten abspielen kannst, auch in Multi-Room-Gruppen.",
          "examplePhrases": [
            "Alexa, spiele Musik auf Mein Plex",
            "Alexa, spiele Rockmusik auf Mein Plex"
          ],
          "keywords": ["musik", "plex", "medienserver"]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": ["US", "DE"],
      "category": "STREAMING_SERVICE"
    },
    "apis": {
      "music": {
        "endpoint": {
          "uri": ""
        },
        "locales": {
          "en-US": {
            "features": [
              { "name": "EXPLICIT_LANGUAGE_FILTER" }
            ],
            "aliases": [
              { "name": "mein plex" }
            ],
            "promptName": "Mein Plex"
          },
          "de-DE": {
            "features": [
              { "name": "EXPLICIT_LANGUAGE_FILTER" }
            ],
            "aliases": [
              { "name": "mein plex" }
            ],
            "promptName": "Mein Plex"
          }
        },
        "interfaces": [
          {
            "namespace": "Alexa.Media.Search",
            "requests": [
              { "name": "GetPlayableContent" }
            ],
            "version": "1.0"
          },
          {
            "namespace": "Alexa.Media.Playback",
            "requests": [
              { "name": "Initiate" },
              { "name": "Reinitiate" }
            ],
            "version": "1.0"
          },
          {
            "namespace": "Alexa.Media.PlayQueue",
            "requests": [
              { "name": "GetItem" }
            ],
            "version": "1.0"
          },
          {
            "namespace": "Alexa.Audio.PlayQueue",
            "requests": [
              { "name": "GetNextItem" },
              { "name": "GetPreviousItem" },
              { "name": "JumpToItem" }
            ],
            "version": "1.0"
          }
        ]
      }
    },
    "events": {
      "subscriptions": [
        { "eventName": "SKILL_ENABLED" },
        { "eventName": "SKILL_DISABLED" },
        { "eventName": "SKILL_ACCOUNT_LINKED" },
        { "eventName": "AUDIO_ITEM_PLAYBACK_STARTED" },
        { "eventName": "AUDIO_ITEM_PLAYBACK_FINISHED" },
        { "eventName": "AUDIO_ITEM_PLAYBACK_STOPPED" },
        { "eventName": "AUDIO_ITEM_PLAYBACK_FAILED" }
      ],
      "endpoint": {
        "uri": ""
      }
    },
    "manifestVersion": "1.0"
  }
}
